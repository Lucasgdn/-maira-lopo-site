rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isActiveBot() {
      return request.auth != null
        && exists(/databases/$(database)/documents/botOperators/$(request.auth.uid))
        && get(/databases/$(database)/documents/botOperators/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /settings/availability {
      allow get: if true;
      allow write: if isActiveAdmin();
    }

    match /settings/reminders {
      allow get: if isActiveBot();
    }

    match /settings/{document=**} {
      allow read, write: if isActiveAdmin();
    }

    match /botOperators/{uid} {
      allow read, write: if false;
    }

    match /botSessions/whatsapp {
      allow get: if isActiveAdmin() || isActiveBot();
      allow list, delete: if false;
      allow create, update: if isActiveBot()
        && request.resource.data.keys().hasOnly([
          "runId", "status", "qr", "qrAt", "updatedAt", "deliveryError"
        ])
        && request.resource.data.runId is string
        && request.resource.data.runId.matches("^[a-f0-9-]{36}$")
        && request.resource.data.status in [
          "starting", "qr", "connected", "disconnecting", "offline", "error"
        ]
        && (request.resource.data.qr == null
          || (request.resource.data.qr is string
            && request.resource.data.qr.size() <= 150000))
        && (request.resource.data.qrAt == null || request.resource.data.qrAt is timestamp)
        && (!("deliveryError" in request.resource.data)
          || request.resource.data.deliveryError == null
          || (request.resource.data.deliveryError is string
            && request.resource.data.deliveryError.size() <= 200))
        && request.resource.data.updatedAt == request.time;
    }

    match /botCommands/whatsapp {
      allow get: if isActiveAdmin() || isActiveBot();
      allow list, delete: if false;
      allow create, update: if isActiveAdmin()
        && request.resource.data.keys().hasOnly(["runId", "requestId", "requestedAt"])
        && request.resource.data.runId is string
        && request.resource.data.runId.matches("^[a-f0-9-]{36}$")
        && request.resource.data.requestId is string
        && request.resource.data.requestId.matches("^[a-f0-9-]{36}$")
        && request.resource.data.requestedAt == request.time;
    }

    match /botDeliveries/{deliveryId} {
      allow read: if isActiveAdmin() || isActiveBot();
      allow create: if isActiveBot()
        && request.resource.data.keys().hasOnly(["kind", "status", "date", "createdAt", "updatedAt"])
        && request.resource.data.kind in ["new", "summary", "customer"]
        && request.resource.data.status == "sending"
        && request.resource.data.date is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveBot()
        && request.resource.data.keys().hasOnly(["kind", "status", "date", "createdAt", "updatedAt"])
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status == "sending"
        && request.resource.data.status in ["sent", "uncertain", "cancelled"]
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "reviewed"
        && (resource.data.status == "uncertain"
          || (resource.data.status == "sending"
            && request.time > resource.data.updatedAt + duration.value(2, "m")))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get, list: if isActiveAdmin() || isActiveBot();
      allow create: if (request.auth == null || isActiveAdmin())
        && request.resource.data.keys().hasOnly([
          "customerName",
          "customerPhone",
          "service",
          "price",
          "durationMinutes",
          "professionalId",
          "professionalName",
          "date",
          "startTime",
          "endTime",
          "slotIds",
          "status",
          "createdAt"
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.matches("^55[0-9]{10,11}$")
        && request.resource.data["service"] is string
        && request.resource.data["service"].size() <= 100
        && request.resource.data.price is string
        && request.resource.data.professionalId is string
        && request.resource.data.professionalId.matches("^[A-Za-z0-9_-]{1,100}$")
        && request.resource.data.professionalName is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.startTime.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
        && request.resource.data.endTime.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 5
        && request.resource.data.durationMinutes <= 240
        && request.resource.data.slotIds is list
        && request.resource.data.slotIds.size() > 0
        && request.resource.data.slotIds.size() <= 48
        && request.resource.data.slotIds[0] is string
        && request.resource.data.durationMinutes == request.resource.data.slotIds.size() * 5
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotIds[0]))
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotIds[0])).data.appointmentId == appointmentId;
      allow update, delete: if isActiveAdmin();
    }

    match /bookingSlots/{slotId} {
      allow read: if true;
      allow create: if (request.auth == null || isActiveAdmin())
        && request.resource.data.keys().hasOnly([
          "appointmentId",
          "professionalId",
          "date",
          "time"
        ])
        && request.resource.data.appointmentId is string
        && request.resource.data.professionalId is string
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.time.matches("^([01][0-9]|2[0-3]):[0-5][0-9]$")
        && slotId == request.resource.data.professionalId + "_" + request.resource.data.date + "_" + request.resource.data.time
        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.professionalId == request.resource.data.professionalId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotIds.hasAny([slotId])
        && request.resource.data.time >= getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.startTime
        && request.resource.data.time < getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.endTime;
      allow update, delete: if isActiveAdmin();
    }
  }
}
